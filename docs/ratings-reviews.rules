// MERGE FRAGMENT, not a standalone ruleset (US 01.13.01, US 01.13.02, US 03.09.01, US 03.10.01).
// Place inside the existing /databases/{database}/documents scope, which already defines isAdmin().
// The /campsites lines at the bottom go inside the existing match /campsites/{campsiteId} block.

function fbPad(n) { return n < 10 ? '0' + string(n) : string(n); }
function fbToday() {
  return string(request.time.year()) + '-' + fbPad(request.time.month()) + '-' + fbPad(request.time.day());
}
// The signed-in entrant finished this stay, and the rating or review belongs to it.
function fbFinishedStay(id, data) {
  let stay = get(/databases/$(database)/documents/reservations/$(id)).data;
  return request.auth != null && stay.entrantId == request.auth.uid
    && stay.status == 'Confirmed' && stay.checkOutDate < fbToday()
    && data.id == id && data.entrantId == request.auth.uid && data.campsiteId == stay.campsiteId
    && data.date is string && data.date.size() == 10;
}
// Only the fields behind a campsite's average change.
function fbOnlyRatingFields() {
  return request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly(['averageRating', 'ratingCount', 'ratingTotal', 'lastRatingId']);
}
// The average grows by exactly the one rating saved in the same write.
function fbAddsRating(campsiteId) {
  let after = request.resource.data;
  let path = /databases/$(database)/documents/ratings/$(after.lastRatingId);
  let rating = getAfter(path).data;
  return fbOnlyRatingFields() && !exists(path) && rating.campsiteId == campsiteId
    && after.ratingCount == resource.data.get('ratingCount', 0) + 1
    && after.ratingTotal == resource.data.get('ratingTotal', 0) + rating.stars
    && after.averageRating == float(after.ratingTotal) / float(after.ratingCount);
}

match /ratings/{ratingId} {
  allow get: if request.auth != null
    && (resource == null || resource.data.entrantId == request.auth.uid || isAdmin());
  allow list: if request.auth != null && (resource.data.entrantId == request.auth.uid || isAdmin());
  allow create: if fbFinishedStay(ratingId, request.resource.data)
    && request.resource.data.keys().hasOnly(['id', 'campsiteId', 'entrantId', 'stars', 'date'])
    && request.resource.data.stars is int
    && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
    && getAfter(/databases/$(database)/documents/campsites/$(request.resource.data.campsiteId)).data.lastRatingId == ratingId;
  allow delete: if isAdmin();
}

match /reviews/{reviewId} {
  allow read: if request.auth != null;
  allow create: if fbFinishedStay(reviewId, request.resource.data)
    && request.resource.data.keys().hasOnly(['id', 'campsiteId', 'entrantId', 'text', 'date'])
    && request.resource.data.text is string
    && request.resource.data.text.size() <= 1000
    && request.resource.data.text.matches('(?s).*[^\\s].*');
  allow delete: if isAdmin();
}

// Inside the existing match /campsites/{campsiteId} block:
//   allow update: if request.auth != null && fbAddsRating(campsiteId);
//   allow update: if isAdmin() && fbOnlyRatingFields();
//
// The owner's existing create rule there also needs, so a new campsite starts with no ratings:
//   && request.resource.data.get('averageRating', null) == null
//   && request.resource.data.get('ratingCount', 0) == 0
//   && request.resource.data.get('ratingTotal', 0) == 0
// and the owner's existing update rule, so owners cannot change their own ratings:
//   && !request.resource.data.diff(resource.data).affectedKeys()
//     .hasAny(['averageRating', 'ratingCount', 'ratingTotal', 'lastRatingId'])

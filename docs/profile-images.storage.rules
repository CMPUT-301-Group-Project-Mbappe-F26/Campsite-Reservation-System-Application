// Merge fragment: place inside the existing match /b/{bucket}/o scope (rules_version = '2').
// Keep existing rules for campsite photos. Do not deploy this as a standalone ruleset.

function profileImageAdmin() {
  return request.auth != null
    && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
}

// Allows admins to discover profile folders and image objects when using Storage listing.
match /profile-images/{allPaths=**} {
  allow list: if profileImageAdmin();
}

match /profile-images/{userId}/{imageId} {
  allow get: if request.auth != null && (request.auth.uid == userId || profileImageAdmin());
  allow create: if request.auth != null && request.auth.uid == userId
    && request.resource.size <= 5 * 1024 * 1024
    && request.resource.contentType == 'image/jpeg'
    && request.resource.metadata.ownerId == userId
    && request.resource.metadata.imageType == 'profile';
  // Replacements have a new filename, so an existing photo is never overwritten.
  allow delete: if request.auth != null && (request.auth.uid == userId || profileImageAdmin());
}
